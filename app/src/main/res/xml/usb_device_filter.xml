<?xml version="1.0" encoding="utf-8"?>
<!--
    USB device filter — match all USB Audio Class (UAC) devices.
    Class 0x01 = Audio, SubClass 0x02 = AudioStreaming.
    Leaving vendor/product IDs unset matches all compliant interfaces.
-->
<resources>
    <usb-device class="1" subclass="2" />
    <usb-device class="1" subclass="3" />
</resources>
